# Kids Note backend — environment variables
# Copy to .env and fill in real values for local development / deployment.

NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kids_note_dev?connection_limit=10&pool_timeout=10
POSTGRES_DB=kids_note_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=replace-with-min-32-char-secret-aaaaaaaaaaaa
JWT_REFRESH_SECRET=replace-with-min-32-char-secret-bbbbbbbbbbbb
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/google/callback

# --- Facebook OAuth ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/facebook/callback

# --- Apple Sign-In ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/apple/callback

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kids-note-media
SUPABASE_STORAGE_PUBLIC_URL=

# --- Resend (transactional email — password reset) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kids Note <onboarding@resend.dev>

# --- AI (stubbed; swap AiModule's AI_PROVIDER binding for a real provider) ---
AI_PROVIDER_API_KEY=

# --- pgAdmin (optional, `docker compose --profile tools up`) ---
PGADMIN_DEFAULT_EMAIL=admin@kidsnote.local
PGADMIN_DEFAULT_PASSWORD=admin
